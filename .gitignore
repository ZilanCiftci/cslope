# Dependencies
node_modules/

# Build output
dist/
dist-electron/
release/
*.tsbuildinfo

# IDE / OS
.vscode/
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log

# Test coverage output
coverage/
**/coverage/
.nyc_output/
coverage-final.json

# Profiling
*.prof

# Generated media assets are checked in: the website is deployed from the
# repository. Regenerate with: bun run media:capture

# Docs (generated), at the repository root only; the file format
# specification is kept
/docs/*
!/docs/file-format.md

# Client project data: kept on the developer's machine only
packages/desktop/src/store/lovo.local.ts
/lovo-*.json

# Agent files
.github/*.md
!.github/pull_request_template.md
# Rust build output
packages/engine-rs/target/
# WebAssembly engine builds (packages/engine-rs/tools/build-wasm.ts): the
# testing build is never committed; the product build (packages/engine/src/
# wasm: the .wasm, its glue and BUILD-INFO.json) is
packages/engine/src/wasm-testing/

# Design review screenshots and findings (packages/desktop/tools/design-review)
design-review-out/
