// @see - https://www.electron.build/configuration/configuration
{
  $schema: "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  appId: "com.cslope.desktop",
  asar: true,
  // Smaller installer (LZMA at its strongest setting) for a slower build.
  compression: "maximum",
  productName: "cSlope",
  directories: {
    output: "release/${version}",
  },
  // The app is bundled by Vite into dist and dist-electron; the main process
  // loads only electron and Node built-ins at runtime, so the packages
  // listed as dependencies (80 MB, already inside the bundle) stay out.
  files: ["dist", "dist-electron", "!node_modules", "!**/LICENSES.chromium.html"],
  icon: "build/icon.png",
  // Only keep English locale files
  electronLanguages: ["en", "en-US"],
  mac: {
    target: ["dmg"],
    icon: "build/icon.png",
    fileAssociations: [{ ext: "cslp", name: "cSlope project", description: "cSlope project", role: "Editor" }],
    artifactName: "${productName}-Mac-${version}-Installer.${ext}",
  },
  // Electron fuses, set in the packaged binary: the signed cSlope.exe cannot
  // be used to run arbitrary Node scripts (ELECTRON_RUN_AS_NODE,
  // NODE_OPTIONS, --inspect), loads the app only from its asar archive,
  // refuses an app.asar whose contents differ from the hash embedded in the
  // executable at packaging (electron-builder writes it into cSlope.exe
  // before signing; checked by package-smoke.yml on a Windows build) and
  // encrypts cookies.
  electronFuses: {
    runAsNode: false,
    enableNodeOptionsEnvironmentVariable: false,
    enableNodeCliInspectArguments: false,
    enableEmbeddedAsarIntegrityValidation: true,
    onlyLoadAppFromAsar: true,
    enableCookieEncryption: true,
  },
  win: {
    icon: "build/icon.png",
    // Double-clicking a .cslp project opens it in cSlope (the installer
    // registers the extension; never .json). Icon: build/icon.ico.
    fileAssociations: [{ ext: "cslp", name: "cSlope project", description: "cSlope project", icon: "icon" }],
    // Azure Trusted Signing (see sign.cjs).
    signtoolOptions: {
      sign: "./sign.cjs",
    },
    target: [
      {
        target: "nsis",
        arch: ["x64"],
      },
    ],
    artifactName: "${productName}-Windows-${version}-Setup.${ext}",
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
  },
  linux: {
    target: ["AppImage"],
    fileAssociations: [{ ext: "cslp", name: "cSlope project", description: "cSlope project", mimeType: "application/x-cslope-project" }],
    artifactName: "${productName}-Linux-${version}.${ext}",
  },
}
