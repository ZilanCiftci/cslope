{
  "name": "@cslope/desktop",
  "private": true,
  "version": "0.1.0-beta.2",
  "description": "cSlope — Slope Stability Analysis",
  "author": "Zilan Ciftci",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "package": "tsc -b && vite build && dotenv -e .env.trustedsigning -- electron-builder",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "preview": "vite preview",
    "verification-report": "bun scripts/verification-report.ts"
  },
  "dependencies": {
    "@cslope/engine": "workspace:*",
    "chroma-js": "^3.2.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.575.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "utif": "3.1.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron/windows-sign": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chroma-js": "^3.1.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "dotenv-cli": "^11.1.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^28.0.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.4",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^5.0.5"
  }
}
