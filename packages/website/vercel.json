{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": { "**": false, "main": true } },
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "installCommand": "cd ../.. && bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)/index.html",
      "destination": "/$1",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/features",
      "destination": "/features/index.html"
    },
    {
      "source": "/verification",
      "destination": "/verification/index.html"
    },
    {
      "source": "/download",
      "destination": "/download/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/changelog",
      "destination": "/changelog/index.html"
    },
    {
      "source": "/docs/analysis",
      "destination": "/docs/analysis/index.html"
    },
    {
      "source": "/docs/drawings",
      "destination": "/docs/drawings/index.html"
    },
    {
      "source": "/docs/file-format",
      "destination": "/docs/file-format/index.html"
    },
    {
      "source": "/docs/geometry",
      "destination": "/docs/geometry/index.html"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/installation",
      "destination": "/docs/installation/index.html"
    },
    {
      "source": "/docs/interface",
      "destination": "/docs/interface/index.html"
    },
    {
      "source": "/docs/loads",
      "destination": "/docs/loads/index.html"
    },
    {
      "source": "/docs/materials",
      "destination": "/docs/materials/index.html"
    },
    {
      "source": "/docs/reinforcement",
      "destination": "/docs/reinforcement/index.html"
    },
    {
      "source": "/docs/reporting",
      "destination": "/docs/reporting/index.html"
    },
    {
      "source": "/docs/results",
      "destination": "/docs/results/index.html"
    },
    {
      "source": "/docs/search",
      "destination": "/docs/search/index.html"
    },
    {
      "source": "/docs/sensitivity",
      "destination": "/docs/sensitivity/index.html"
    },
    {
      "source": "/docs/shortcuts",
      "destination": "/docs/shortcuts/index.html"
    },
    {
      "source": "/docs/theory",
      "destination": "/docs/theory/index.html"
    },
    {
      "source": "/docs/tutorials/dam",
      "destination": "/docs/tutorials/dam/index.html"
    },
    {
      "source": "/docs/tutorials/first-analysis",
      "destination": "/docs/tutorials/first-analysis/index.html"
    },
    {
      "source": "/docs/tutorials",
      "destination": "/docs/tutorials/index.html"
    },
    {
      "source": "/docs/tutorials/layered",
      "destination": "/docs/tutorials/layered/index.html"
    },
    {
      "source": "/docs/tutorials/partial-factors",
      "destination": "/docs/tutorials/partial-factors/index.html"
    },
    {
      "source": "/docs/tutorials/probabilistic",
      "destination": "/docs/tutorials/probabilistic/index.html"
    },
    {
      "source": "/docs/tutorials/reporting",
      "destination": "/docs/tutorials/reporting/index.html"
    },
    {
      "source": "/docs/tutorials/soil-nails",
      "destination": "/docs/tutorials/soil-nails/index.html"
    },
    {
      "source": "/docs/tutorials/water-table",
      "destination": "/docs/tutorials/water-table/index.html"
    },
    {
      "source": "/docs/water",
      "destination": "/docs/water/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-IuyRvK+Y4VdFudbSxXbbeq4aKhG2VSQh+LTePAiqBMo='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
